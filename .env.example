# --- Spotify ---
# How to turn a spoken song name into a track:
#   auto = try the local Spotify app UI first, fall back to Web API (default)
#   app  = local app UI only, no key needed (best-effort; needs Accessibility perm)
#   web  = Web API only (most reliable; needs the key below)
SPOTIFY_SEARCH_MODE=auto

# OPTIONAL: only needed for the Web API path (mode=web, or as auto's fallback).
# Register a free app at https://developer.spotify.com/dashboard. Search uses the
# Client-Credentials flow, so NO user login / OAuth redirect is involved.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Local models ---
# LLM served by Ollama (OpenAI-compatible endpoint)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# STT (faster-whisper). Options: tiny.en, base.en, small.en, medium.en, large-v3-turbo
WHISPER_MODEL=base.en

# TTS (Kokoro). British male voices for the JARVIS feel: bm_george, bm_lewis
KOKORO_VOICE=bm_george
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
