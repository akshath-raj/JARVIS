# ═══ Mode ═══════════════════════════════════════════════════════════════
# 1 = CLOUD (default): Deepgram nova-3 STT + Cerebras brain + Deepgram Aura-2 TTS.
#                      Needs DEEPGRAM_API_KEY + CEREBRAS_API_KEY (see below).
# 0 = LOCAL          : Whisper + Kokoro, fully on-device. Nothing leaves the Mac.
JARVIS_MODE=1
# In cloud mode, run device-action agents (music/calendar/files) on the LOCAL
# LLM (Ollama) for reliable, private tool execution; answering stays cloud.
# Requires Ollama running. Set 0 to use the cloud LLM for everything.
JARVIS_HYBRID_LOCAL_ACTIONS=1

# ═══ Activation (wake word + smart follow-up) ═══════════════════════════
# Say "jarvis" or "hey jarvis" to activate. After JARVIS asks a clarifying
# question the next turn needs no wake word; after a normal answer it sleeps again.
JARVIS_WAKE=1                 # 0 = always-on (reply to everything, no wake word)
# Comma-separated trigger words. Includes common Whisper mishearings of "jarvis"
# (jairus/jarvus/jervis/javis) so the wake gate still fires on a slight mistranscription.
JARVIS_WAKE_WORDS=jarvis,jairus,jarvus,jervis,javis
JARVIS_WAKE_FOLLOWUP=5        # seconds the follow-up window stays open
JARVIS_TURN_DETECTOR=1        # LiveKit MultilingualModel endpointing (better turns)

# ═══ Brain / orchestrator ═══════════════════════════════════════════════
# openai (default, full features) = OpenAI Agents SDK: ONE fast agent (Cerebras or
#           OpenAI) with every tool — music, browser, screen vision, on-screen doc
#           explanation, document RAG, files, calendar/reminders, focus mode, HUD.
#           It chains tools for multi-step requests. This is the brain everything
#           below targets.
# langgraph = leaner LangGraph react-agent (music/browser/web/memory only), fully
#           local-capable. native = previous hand-rolled agent (rollback).
JARVIS_ORCHESTRATOR=openai
# Which provider backs the agent brain: openai | cerebras. Cerebras (gpt-oss-120b,
# OpenAI-compatible, ~2000+ tok/s) benchmarked SAME tool-calling accuracy at ~3.4x
# lower latency (~0.5s vs ~1.8s) — recommended. When set to cerebras, the brain, RAG
# answering AND screen vision ALL run on Cerebras (text on CEREBRAS_MODEL, images on
# JARVIS_CEREBRAS_VISION_MODEL) for uniformly fast responses. Reasoning effort is
# forced low (gpt-oss is a reasoning model — less reasoning = faster). Needs
# CEREBRAS_API_KEY; falls back to the OpenAI models below if that key is missing.
JARVIS_AGENT_PROVIDER=cerebras
CEREBRAS_MODEL=gpt-oss-120b
# Cerebras multimodal model for images (screenshots/docs/charts): Gemma 4 31B,
# ~1800 tok/s, OpenAI-compatible image inputs — much faster than gpt-4o for vision.
JARVIS_CEREBRAS_VISION_MODEL=gemma-4-31b
# OpenAI models used only when JARVIS_AGENT_PROVIDER=openai (or Cerebras key absent):
JARVIS_CLOUD_AGENT_MODEL=gpt-5.4-mini
# OpenAI vision fallback. Requires macOS Screen Recording permission for your terminal.
JARVIS_VISION_MODEL=gpt-4o

# HUD dashboard — a hidden Iron-Man-style interface JARVIS reveals on voice command
# ("open the dashboard"). Shows your profile/memories/past conversations and renders
# explanations (e.g. a screen analysis) on screen. Served locally only.
JARVIS_UI=1
JARVIS_UI_PORT=8137
JARVIS_UI_USER=Akshath        # name shown in the "Welcome back, ___" boot animation

# Calendar / to-do list / reminders + alarms. JARVIS is time-aware: "remind me to
# submit the assignment at 9pm", "remind me in an hour", "I'm done with X". A due
# reminder rings a looping macOS alarm sound + pops up on the HUD (STOP / MARK
# DONE) + speaks; say "Jarvis, stop the alarm" to silence it.
JARVIS_SCHEDULER=1
JARVIS_ALARM_SOUND=           # empty = /System/Library/Sounds/Sosumi.aiff

# ═══ Focus assist mode ══════════════════════════════════════════════════
# "focus mode" / "start a pomodoro" / "help me focus" closes every open
# distraction (Instagram, YouTube, Netflix, TikTok, Reddit, X, …), starts a timed
# regime, and keeps closing anything distracting you reopen — announcing that
# focus mode is on — until you say "end focus mode". Techniques: pomodoro (25/5,
# default), classic (50/10), 52-17, 90-20, flowtime.
JARVIS_FOCUS=1
JARVIS_FOCUS_TECHNIQUE=pomodoro
JARVIS_FOCUS_POLL=3            # seconds between distraction sweeps while focused
# Extra comma-separated distraction domains to block (added to the built-in list):
JARVIS_FOCUS_BLOCK_SITES=
# Comma-separated macOS APP names to QUIT on focus (e.g. Messages,Discord). Empty
# by default so nothing with unsaved work is closed without you opting in.
JARVIS_FOCUS_BLOCK_APPS=

# ═══ Document RAG (ask questions about your files) ══════════════════════
# JARVIS indexes your documents (PDF/DOCX/PPTX/TXT/MD) into a local vector store
# and answers questions from them, citing sources. The index self-updates: new
# downloads are added, changed files re-embedded, deleted files dropped — without
# re-embedding everything. Embeddings are LOCAL by default (needs: ollama pull
# nomic-embed-text) so your documents never leave the machine.
JARVIS_RAG=1
JARVIS_RAG_EMBED=ollama                 # ollama (local, private) | openai
JARVIS_RAG_EMBED_MODEL=nomic-embed-text
JARVIS_RAG_INDEX_DIR=~/.jarvis/rag
JARVIS_RAG_DIRS=~/Downloads,~/Documents,~/Desktop   # folders to index (auto-ingest)
JARVIS_RAG_SCAN_SECONDS=120             # rescan interval for new files (0 = off)

# ═══ Sandboxed file organiser (read / copy / move / open — NEVER delete) ═
# "organise my downloads", "move X to Y", "open my recent downloads". Confined to
# the sandbox root; JARVIS can never move files outside it and never deletes.
JARVIS_FILES=1
JARVIS_FILES_SANDBOX=~         # everything JARVIS touches must stay under here
# Long-term memory (GPT-style). Needs a local embedding model:
#   ollama pull nomic-embed-text
JARVIS_EMBED_MODEL=nomic-embed-text
JARVIS_EMBED_DIMS=768
JARVIS_MEMORY_DIR=~/.jarvis/memory        # where learned memories persist (local JSON)
JARVIS_EXTRACT_MODEL=qwen2.5:3b-instruct  # small model that mines convos for facts
JARVIS_EXTRACT_EVERY=4                     # run the extractor every N replies (0=off)

# ═══ LOCAL pipeline (per-task models — smaller = faster) ════════════════
OLLAMA_MODEL=qwen2.5:3b-instruct         # chat / router (non-thinking = fast)
JARVIS_TOOL_MODEL=qwen2.5:7b-instruct    # device tool-calling (reliable on any song; 3b=faster/less accurate)
OLLAMA_BASE_URL=http://localhost:11434/v1
WHISPER_BACKEND=mlx           # "mlx" (Metal, fastest) or "faster" (CPU)
WHISPER_MODEL=base.en         # tiny.en | base.en | small.en | medium.en | large-v3-turbo
KOKORO_VOICE=bm_george        # British male; bm_lewis also good
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# ═══ CLOUD pipeline (only needed when JARVIS_MODE=1) ════════════════════
# LLM — Cerebras is preferred; OpenAI is used if Cerebras key is absent.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# STT + TTS (Deepgram handles both). aura-2-draco-en = British male, JARVIS-like.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-draco-en

# ═══ Browser / Web (Chrome + Tavily) ════════════════════════════════════
# JARVIS can open Chrome and open/play whatever you ask (youtube, instagram,
# reels, a creator's latest video, …) and look up recent news / live info.
JARVIS_BROWSER_APP=Google Chrome    # macOS app name of the browser to drive
# Live web search / recent news. Get a free key at https://tavily.com
TAVILY_API_KEY=

# --- Browser AGENT (browser-use, isolated) ---
# Multi-step logged-in web workflows: "download my OS notes from VTOP", "check my
# AWS balance". Runs in a SEPARATE venv (.venv-browser) — first run:
#   bash scripts/setup_browser_agent.sh
# Drives your REAL Chrome profile (saved logins), so Chrome must be CLOSED when a
# task runs. Reasoning uses a frontier model via OPENAI_API_KEY (local models
# can't drive a browser reliably). NOTE: browsed page content goes to OpenAI, and
# with full autonomy on your logged-in profile a malicious page could misdirect it.
JARVIS_BROWSER_AGENT=1
JARVIS_BROWSER_FRONTIER_MODEL=gpt-4.1-mini
JARVIS_BROWSER_USE_LOCAL=0            # experimental local-first path (unreliable)
JARVIS_BROWSER_PROFILE=Default        # which Chrome profile to drive
# A Chrome profile can only be used by ONE Chrome at a time. To run headless in the
# background WHILE your Chrome is open, JARVIS clones the profile (cookies/logins) and
# drives the copy. auto = clone only when Chrome is open; always = always clone; never
# = require Chrome closed. Sites you're logged into in Chrome carry over to the clone.
JARVIS_BROWSER_CLONE_PROFILE=auto
JARVIS_BROWSER_DOWNLOADS=~/Downloads
JARVIS_BROWSER_MAX_STEPS=40
JARVIS_BROWSER_TIMEOUT=240
JARVIS_BROWSER_HEADLESS=0
# Auto-solve captchas that block a task, using a LOCAL open-source vision model
# (Qwen2.5-VL via Ollama) — free, private, no third-party service. Set up once:
#   ollama pull qwen2.5vl:7b
JARVIS_BROWSER_CAPTCHA=1
JARVIS_CAPTCHA_MODEL=qwen2.5vl:7b

# --- Documents / assignments ---
# "download my assignment and explain it" → "finish it as an ipynb" → "open it".
# Preferred AI apps to DO the assignment, in order (first available wins). Claude
# desktop is only used if Claude.app is installed AND macOS Accessibility is granted
# to JARVIS AND JARVIS_CLAUDE_DESKTOP=1 — otherwise it falls back to the browser
# (claude.ai, via the browser agent using your OpenAI key to drive it).
JARVIS_AI_APP_ORDER=claude_desktop,browser
JARVIS_CLAUDE_DESKTOP=0                    # 1 = try the (experimental) Claude desktop backend
JARVIS_EXPLAIN_MODEL=qwen2.5:7b-instruct   # local model that explains a downloaded doc
JARVIS_ANSWERS_DIR=~/Downloads             # where assembled answer files are written

# ═══ Spotify ════════════════════════════════════════════════════════════
# auto = web search when a key is set (fully background), else app UI | app | web
SPOTIFY_SEARCH_MODE=auto
# https://developer.spotify.com/dashboard — needed for search (client-credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Playlist features (play/add-to your playlists) use user OAuth. Add this exact
# URI to your Spotify app's Redirect URIs, then run: python -m jarvis.spotify_auth
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
